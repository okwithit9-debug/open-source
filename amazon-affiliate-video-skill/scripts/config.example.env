# Copy to .env (or export these) before running the helpers.
# Nothing here is required to be secret; do not put passwords or keys in this file.

# Your Amazon Associates tracking ID (store ID). Per-channel IDs work too.
AFFILIATE_TAG=YOUR_TAG-20

# Where post-ready clips + sidecars are written.
READY_DIR=/path/to/ready

# Shown in IG/TikTok captions ("link in bio") and optional still footers.
BRAND_NAME=YOUR_BRAND
SOCIAL_HANDLE=YOUR_HANDLE

# Optional landing page for platforms that block direct affiliate links.
LANDING_URL=https://YOUR_SITE.example

# Optional TTF/OTF font for burned-in "#ad" (falls back to ffmpeg default font).
FONT_FILE=

# Optional local generator or helper endpoint, if you run one.
GENERATOR_URL=http://localhost:PORT
