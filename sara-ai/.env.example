# Sara AI — copy to .env and fill locally.
# Do NOT commit .env. Real passwords / tokens live in a password manager.

# ---------------------------------------------------------------------------
# Tabby (ALREADY LIVE on Spark). Do not rebuild, start, stop, or retarget.
# Do NOT point this at Mac oMLX 27B (:8000). That backup stays untouched.
# Open WebUI reaches Tabby on the private LAN only — never via Serve/Tunnel.
# Tabby listen policy (do not change the live unit from here): 127.0.0.1 or
# LAN/Tailscale IP LLM_LAN_IP — never 0.0.0.0 on the public internet, never
# router port-forward :8001.
# ---------------------------------------------------------------------------
OPENAI_API_BASE_URL=http://LLM_LAN_IP:8001/v1
# Docker Desktop on Mac cannot reach the LAN from containers. Use the loopback relay instead
# (image-gen/mac/install-always-on.sh installs it):
# OPENAI_API_BASE_URL=http://host.docker.internal:8001/v1
# Placeholder only. If Tabby ever requires a key, put the real one in .env
# (a password manager), never in git.
OPENAI_API_KEY=local-placeholder
DEFAULT_MODELS=Qwen3.8-Flash-Next-Uncensored-exl3-4bpw

# Host that runs Open WebUI (a Mac or a small always-on LAN box).
# Bind localhost only — Tailscale Serve or Cloudflare Tunnel sit in front.
# Never publish Tabby :8001 itself. Never set WEBUI_BIND=0.0.0.0 toward a WAN.
WEBUI_BIND=127.0.0.1
WEBUI_PORT=8080
WEBUI_NAME=Sara AI

# Public/tailnet URL the phones will open (HTTPS). Set after Serve/Tunnel is up.
# Example: https://chat.example.com
WEBUI_URL=http://127.0.0.1:8080
# Must match WEBUI_URL once phones are on HTTPS (semicolon-separated if both
# localhost bootstrap and the public HTTPS URL are needed during cutover).
CORS_ALLOW_ORIGIN=http://127.0.0.1:8080

# Persistent session secret. Generate once, keep in a password manager:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=replace-with-a-long-random-hex

# Auth: first browser signup becomes admin if WEBUI_ADMIN_* are left empty.
# After the 3–4 named household users exist, set ENABLE_SIGNUP=false and
# `docker compose up -d`. Do not leave public signup on.
ENABLE_SIGNUP=true
# WEBUI_AUTH is forced true in compose. Do not try to enable anonymous access.

# Optional headless admin (first boot only). Leave blank to use the signup page.
# If both are set, Open WebUI creates the admin and disables signup.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Admin

# Sessions. Leave Secure=false for the first localhost bootstrap, then true
# once WEBUI_URL is https://… (Tailscale Serve or Cloudflare).
JWT_EXPIRES_IN=7d
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SECURE=false
WEBUI_SESSION_COOKIE_SAME_SITE=strict
WEBUI_AUTH_COOKIE_SAME_SITE=strict

# Vision uploads (MB / count / extensions). Chat images go to local Tabby only.
RAG_FILE_MAX_SIZE=8
RAG_FILE_MAX_COUNT=4
RAG_ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,webp

# Image *generation* is Mac ComfyUI (FLUX FP8), not Tabby, not 27B, not cloud.
# Spark does not have headroom (~6.9 GiB free vs 12–16 GiB FLUX). See image-gen/.
ENABLE_IMAGE_GENERATION=true
ENABLE_IMAGE_PROMPT_GENERATION=true
IMAGE_GENERATION_ENGINE=comfyui
IMAGE_SIZE=1024x1024
IMAGE_STEPS=20
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_API_KEY=
# After first boot, import image-gen/workflows/flux-fp8-photoreal.json in Admin.
# Node map (also the compose default): prompt=6, size=5, steps/seed=3.

# Optional Cloudflare Tunnel compose profile (`docker compose --profile cloudflare up -d`).
# Create the tunnel in the Cloudflare Zero Trust dashboard; paste the token here.
# Point the tunnel service at http://open-webui:8080 when cloudflared is in this compose.
# Access allowlist is mandatory — see cloudflare/access-policy.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional Tailscale sidecar profile (`docker compose --profile tailscale up -d`).
# Prefer host Tailscale (`tailscale serve`) on the Mac. Sidecar is for a headless box.
# Auth key: Tailscale admin → Settings → Keys → Generate auth key (reusable, tagged).
TS_AUTHKEY=
TS_HOSTNAME=sara-ai
