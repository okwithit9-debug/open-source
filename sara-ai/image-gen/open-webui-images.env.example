# Merge into sara-ai/.env (or paste in Admin → Images).
# Local ComfyUI on the same Mac. No cloud image APIs.

ENABLE_IMAGE_GENERATION=true
ENABLE_IMAGE_PROMPT_GENERATION=true
ENABLE_IMAGE_EDIT=false
IMAGE_GENERATION_ENGINE=comfyui
IMAGE_SIZE=1024x1024
IMAGE_STEPS=20
# One image at a time — do not raise batch. Four users share this queue.

# Docker Open WebUI → host ComfyUI
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_API_KEY=

# After first boot these persist in the Open WebUI DB. Change style in Admin
# or re-import image-gen/workflows/flux-fp8-*.json (see switch-style.sh).
COMFYUI_WORKFLOW_NODES=[{"type":"prompt","key":"text","node_ids":["6"]},{"type":"width","key":"width","node_ids":["5"]},{"type":"height","key":"height","node_ids":["5"]},{"type":"steps","key":"steps","node_ids":["3"]},{"type":"seed","key":"seed","node_ids":["3"]}]
