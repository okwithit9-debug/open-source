# Copy to image-gen/.env on the Mac. Do not commit.
# HF token only if a download is gated. Prefer huggingface-cli login.

# ComfyUI checkout (created by install-mac.sh).
COMFYUI_HOME=
# Default: $HOME/ComfyUI

# Hugging Face token (password manager). Needed if Comfy-Org / BFL require auth.
HF_TOKEN=

# Headless API bind — localhost only. Open WebUI on this Mac uses
# host.docker.internal:8188. Do not listen on 0.0.0.0.
COMFYUI_LISTEN=127.0.0.1
COMFYUI_PORT=8188
